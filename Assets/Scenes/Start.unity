  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "S\u1EF1 ki\u1EC7n T\u1EBFt M\u1EADu Th\xE2n (T\u1ED5ng c\xF4ng k\xEDch
    v\xE0 n\u1ED5i d\u1EADy T\u1EBFt M\u1EADu Th\xE2n 1968) l\xE0 cu\u1ED9c t\u1ED5ng
    ti\u1EBFn c\xF4ng v\xE0 v\u1EADn \u0111\u1ED9ng qu\u1EA7n ch\xFAng n\u1ED5i d\u1EADy
    gi\xE0nh ch\xEDnh quy\u1EC1n v\xE0o d\u1ECBp T\u1EBFt M\u1EADu Th\xE2n n\u0103m
    1968 c\u1EE7a Qu\xE2n Gi\u1EA3i ph\xF3ng mi\u1EC1n Nam Vi\u1EC7t Nam. Chi\u1EBFn
    d\u1ECBch di\u1EC5n ra tr\xEAn h\u1EA7u h\u1EBFt c\xE1c \u0111\xF4 th\u1ECB t\u1EA1i
    mi\u1EC1n Nam, \u0111\xE1nh v\xE0o nh\u1EEFng khu v\u1EF1c tr\u1ECDng y\u1EBFu
    c\u1EE7a qu\xE2n \u0111\u1ED9i M\u1EF9 v\xE0 ch\u1EBF \u0111\u1ED9 Vi\u1EC7t
    Nam C\u1ED9ng h\xF2a. \u0110\xE2y l\xE0 m\u1ED9t trong nh\u1EEFng chi\u1EBFn
    d\u1ECBch qu\xE2n s\u1EF1 l\u1EDBn nh\u1EA5t, c\xF3 m\u1ED9t vai tr\xF2 v\xE0
    h\u1EC7 qu\u1EA3 mang t\xEDnh b\u01B0\u1EDBc ngo\u1EB7t trong Chi\u1EBFn tranh
    Vi\u1EC7t Nam"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
